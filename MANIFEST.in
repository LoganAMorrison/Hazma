global-include *.txt *.rst *.md
include MANIFEST.in

# The sweep above carried *.pyx *.pxd *.c until cython-to-rust Task 6.4
# deleted the last Cython source. Dropping the patterns is not just
# tidiness: *.c matched no tracked file even then, only the gitignored
# output of a local build, so an sdist built from a dirty tree shipped
# transpiler artifacts. The Rust sources are included explicitly below.

# The global-include above is a repo-wide sweep, so it also picks up the
# agent-workflow scaffolding: `.claude/` and `.codex/` skills, and the
# `projects/` plans, task notes and ADRs. None of that belongs in a
# published sdist. (The wheel is already clean — see
# [tool.setuptools.packages.find] in pyproject.toml.)
prune .claude
prune .codex
prune projects

# The Rust crate that becomes hazma._core. An sdist is a *source*
# distribution, so it has to carry what setuptools-rust will build:
# the manifest, the lockfile, the build script and the sources. None of
# them match the global-include patterns above. `target/` is build
# output and is excluded by omission (recursive-include names only .rs).
include rust/Cargo.toml
include rust/Cargo.lock
include rust/build.rs
recursive-include rust/src *.rs

include hazma/gamma_ray_data/*.dat
include hazma/gamma_ray_data/A_eff/*.dat
include hazma/gamma_ray_data/bg_model/*.dat
include hazma/gamma_ray_data/energy_res/*.dat
include hazma/gamma_ray_data/obs/*.dat
include hazma/pbh_data/*.csv
include hazma/cmb_data/*.dat
include hazma/relic_density/*.dat
include hazma/spectra/_photon/data/*.csv
include hazma/spectra/_positron/data/*.csv
include hazma/spectra/_neutrino/data/*.csv
include hazma/limits/data/*.dat
